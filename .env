# PostgreSQL — créer la base : createdb globaltrack (ou CREATE DATABASE dans psql)
# Ancienne SQLite conservée dans prisma/dev.db si vous migrez les données manuellement.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/globaltrack"
JWT_SECRET="globaltrack-dev-secret-key-min-32-chars-ok"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"
PORT=3002
NODE_ENV=development
FRONTEND_URL="https://global-track-zeta.vercel.app/"
IMEI_INFO_API_KEY=""
IMEICHECK_API_KEY=""
LOG_LEVEL=debug

# SickW API — https://sickw.com/
SICKW_API_KEY="S5G-TAH-QD1-99R-ZR3-IJV-ESQ-4XE"
