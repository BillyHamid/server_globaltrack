{
  "name": "globaltrack-backend",
  "version": "1.0.0",
  "private": true,
  "description": "GlobalTrack REST API — gestion de stock et ventes de téléphones",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "build": "prisma generate",
    "start": "node src/server.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.js",
    "db:seed:users-only": "node prisma/seed-users-only.js",
    "db:reset": "prisma migrate reset --force && node prisma/seed.js",
    "db:reset:empty": "prisma migrate reset --force --skip-seed && node prisma/seed-users-only.js",
    "db:studio": "prisma studio",
    "check": "node --check src/server.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
