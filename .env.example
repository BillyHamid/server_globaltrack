# ─── Database — PostgreSQL (obligatoire) ───────────────────────────────────────
# Driver inclus dans @prisma/client ; pas de dépendance `pg` séparée requise.
# Pool production : ajouter par ex. ?connection_limit=10&pool_timeout=20 à l’URL
# ou utiliser un pooler (PgBouncer) — voir https://www.prisma.io/docs/orm/prisma-client/setup-and-configuration/databases-connections
DATABASE_URL="postgresql://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/globaltrack"

# Sauvegarde avant migration depuis SQLite : copier prisma/dev.db ailleurs, puis exporter/importer les données si besoin.

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="change-this-secret-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL="https://global-track-zeta.vercel.app/"


# ─── IMEI Validation API ──────────────────────────────────────────────────────
# imei.info — Meilleure base TAC (450+ paramètres), mises à jour hebdomadaires
# Inscription : https://imei.info/api/
# Tarif : ~0.10 USD/requête, essai gratuit disponible
IMEI_INFO_API_KEY=""

# IMEICheck.com — Alternative, spécialisé Apple & Samsung
# Inscription : https://imeicheck.com/developer
IMEICHECK_API_KEY=""

# SickW — vérification IMEI / services (POST /api/imei/sickw)
# Ne jamais committer la clé réelle ; renseigner dans backend/.env uniquement.
SICKW_API_KEY=""
# Identifiant du service SickW à utiliser par défaut (ex. depuis le tableau SickW).
SICKW_SERVICE_ID=""

# Reincubate DeviceIdentifier — lookup Apple (IMEI / serial)
# https://reincubate.com/deviceidentifier-api/  (optionnel : mode anonyme très limité)
RI_DEVID_TOKEN=""

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
