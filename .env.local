# === PostgreSQL Database Configuration ===
# Pour développement local, utilisez les identifiants par défaut PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/globaltrack"

# === JWT Configuration ===
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRE_IN="7d"
REFRESH_TOKEN_EXPIRE_IN="30d"

# === Server Configuration ===
PORT=3000
NODE_ENV="development"

# === CORS Configuration ===
FRONTEND_URL="http://localhost:5173"

# === SickW API (optionnel) ===
# SICKW_SERVICE_ID="your-service-id"
