// GlobalTrack — Prisma Schema
// DATABASE_URL : PostgreSQL (ex. postgresql://user:pass@localhost:5432/globaltrack)
// Pool / prod : voir https://www.prisma.io/docs/orm/prisma-client/setup-and-configuration/databases-connections

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User ──────────────────────────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("vendeur") // admin | vendeur | gestionnaire
  phone     String   @default("")
  avatar    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  phonesAdded             Phone[]            @relation("AddedBy")
  phoneExitsCreated       PhoneExit[]        @relation("ExitCreatedBy")
  salesMade               Sale[]             @relation("Seller")
  salesVerified           Sale[]             @relation("VerifiedBy")
  paymentsReceived        Payment[]          @relation("ReceivedBy")
  movements               StockMovement[]    @relation("PerformedBy")
  activityLogs            ActivityLog[]
  phoneDeletionsPerformed PhoneDeletionLog[] @relation("PhoneDeletionByUser")
  phoneDeletionSnapshots  PhoneDeletionLog[] @relation("PhoneDeletionOriginalAdder")

  @@map("users")
}

// ─── Phone (Stock) ─────────────────────────────────────────────────────────
model Phone {
  id            String   @id @default(cuid())
  brand         String
  model         String
  capacity      String   @default("")
  color         String   @default("")
  sellingPrice  Float
  purchasePrice Float? // prix d'achat (optionnel)
  imei          String?  @unique
  status        String   @default("disponible") // disponible | vendu | credit | sortie
  photos        String   @default("[]") // JSON array sérialisé
  addedAt       DateTime @default(now())
  notes         String   @default("")

  addedById String
  addedBy   User   @relation("AddedBy", fields: [addedById], references: [id])

  sales     Sale[]
  movements StockMovement[]
  exits     PhoneExit[]

  @@index([addedById])
  @@index([status])
  @@map("phones")
}

// ─── Sortie (essai / dépôt vente — 48 h) ────────────────────────────────────
model PhoneExit {
  id          String    @id @default(cuid())
  personName  String
  motif       String
  phoneId     String
  phone       Phone     @relation(fields: [phoneId], references: [id])
  // Client lié à la sortie (nouvelles sorties ; historique peut être null).
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  dueAt       DateTime
  status      String    @default("en_cours") // en_cours | retournee
  createdAt   DateTime  @default(now())
  returnedAt  DateTime?
  // Preuve que l’appareil est bien revenu (photo / capture, data URL)
  returnProof String    @default("")

  createdById String
  createdBy   User   @relation("ExitCreatedBy", fields: [createdById], references: [id])

  @@index([clientId])
  @@index([createdById])
  @@index([status])
  @@map("phone_exits")
}

// ─── Client ────────────────────────────────────────────────────────────────
model Client {
  id             String   @id @default(cuid())
  name           String
  phone          String
  email          String   @default("")
  address        String   @default("")
  totalPurchases Int      @default(0)
  createdAt      DateTime @default(now())

  sales      Sale[]
  phoneExits PhoneExit[]

  @@map("clients")
}

// ─── Sale ──────────────────────────────────────────────────────────────────
model Sale {
  id              String    @id @default(cuid())
  type            String // cash | credit
  listPriceAtSale Float? // prix catalogue / fiche stock au moment de la vente
  totalAmount     Float
  paidAmount      Float     @default(0)
  remainingAmount Float
  paymentStatus   String    @default("impaye") // paye | partiel | impaye
  status          String    @default("active") // active | annulée
  date            DateTime  @default(now())
  dueDate         DateTime?
  notes           String    @default("")

  phoneId  String
  phone    Phone  @relation(fields: [phoneId], references: [id])
  clientId String
  client   Client @relation(fields: [clientId], references: [id])
  sellerId String
  seller   User   @relation("Seller", fields: [sellerId], references: [id])

  // ─── Vérification gestionnaire ─────────────────────────────────────────────
  verificationStatus  String? // approuve | anomalie
  verificationComment String    @default("")
  verifiedAt          DateTime?
  verifiedById        String?
  verifiedBy          User?     @relation("VerifiedBy", fields: [verifiedById], references: [id])

  payments Payment[]

  @@index([sellerId])
  @@index([paymentStatus])
  @@index([clientId])
  @@index([date])
  @@index([verificationStatus])
  @@map("sales")
}

// ─── Payment ───────────────────────────────────────────────────────────────
model Payment {
  id           String   @id @default(cuid())
  amount       Float
  date         DateTime @default(now())
  method       String   @default("cash") // cash | mobile_money | virement
  notes        String   @default("")
  // Capture / preuve de dépôt bancaire (data URL JPEG)
  depositProof String   @default("")

  saleId       String
  sale         Sale   @relation(fields: [saleId], references: [id])
  receivedById String
  receivedBy   User   @relation("ReceivedBy", fields: [receivedById], references: [id])

  @@index([saleId])
  @@index([date])
  @@map("payments")
}

// ─── StockMovement ─────────────────────────────────────────────────────────
model StockMovement {
  id    String   @id @default(cuid())
  type  String // entree | vente | retour | sortie | retour_sortie
  date  DateTime @default(now())
  notes String   @default("")

  phoneId       String
  phone         Phone  @relation(fields: [phoneId], references: [id])
  performedById String
  performedBy   User   @relation("PerformedBy", fields: [performedById], references: [id])

  @@map("stock_movements")
}

// ─── Alert ─────────────────────────────────────────────────────────────────
model Alert {
  id          String   @id @default(cuid())
  type        String // stock_ancien | credit_retard | incoherence | sortie_echeance
  title       String
  description String
  status      String   @default("nouvelle") // nouvelle | vue | resolue
  relatedId   String? // phoneId ou saleId
  createdAt   DateTime @default(now())

  @@index([status])
  @@index([type, relatedId])
  @@map("alerts")
}

// ─── PhoneDeletionLog — instantané conservé quand un téléphone est supprimé ─
model PhoneDeletionLog {
  id          String   @id @default(cuid())
  deletedAt   DateTime @default(now())
  deletedById String
  deletedBy   User     @relation("PhoneDeletionByUser", fields: [deletedById], references: [id])

  formerPhoneId String
  brand         String
  model         String
  capacity      String   @default("")
  color         String   @default("")
  imei          String?
  sellingPrice  Float
  purchasePrice Float?
  status        String
  photos        String   @default("[]")
  notes         String   @default("")
  addedAt       DateTime
  addedById     String
  addedBy       User     @relation("PhoneDeletionOriginalAdder", fields: [addedById], references: [id])

  @@index([deletedAt])
  @@index([imei])
  @@map("phone_deletion_logs")
}

// ─── ActivityLog ───────────────────────────────────────────────────────────
model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  details   String
  timestamp DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([timestamp])
  @@map("activity_logs")
}

// ─── RefreshToken ──────────────────────────────────────────────────────────
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}
